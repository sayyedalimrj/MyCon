{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MyCON BIM/IFC reviewed feature adapter v1",
  "type": "object",
  "required": [
    "schema_version",
    "source_frame",
    "target_frame",
    "target_units",
    "model_provenance",
    "matches",
    "planes"
  ],
  "properties": {
    "schema_version": {
      "const": "mycon.bim_feature_adapter.v1"
    },
    "source_frame": {
      "type": "string",
      "minLength": 1
    },
    "target_frame": {
      "const": "bim_world"
    },
    "target_units": {
      "const": "m"
    },
    "model_provenance": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "IFC",
            "BIM_derived",
            "synthetic_fixture_only"
          ]
        },
        "revision": {
          "type": "string"
        },
        "asset": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match_id",
          "kind",
          "role",
          "scan_xyz",
          "bim_xyz_m",
          "observation_state",
          "approval"
        ],
        "properties": {
          "match_id": {
            "type": "string"
          },
          "physical_feature_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "corner",
              "plane"
            ]
          },
          "role": {
            "enum": [
              "fit",
              "control"
            ]
          },
          "scan_xyz": {
            "$ref": "#/$defs/point"
          },
          "bim_xyz_m": {
            "$ref": "#/$defs/point"
          },
          "scan_normal_xyz": {
            "$ref": "#/$defs/point"
          },
          "bim_normal_xyz": {
            "$ref": "#/$defs/point"
          },
          "observation_state": {
            "enum": [
              "observed_supported",
              "field_verified",
              "candidate_extrapolated",
              "unknown"
            ]
          },
          "approval": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "planes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "plane_id",
          "point_xyz_m",
          "normal_xyz",
          "finite_vertices_xyz_m",
          "observation_support",
          "approval"
        ],
        "properties": {
          "plane_id": {
            "type": "string"
          },
          "point_xyz_m": {
            "$ref": "#/$defs/point"
          },
          "normal_xyz": {
            "$ref": "#/$defs/point"
          },
          "finite_vertices_xyz_m": {
            "type": "array",
            "minItems": 3,
            "items": {
              "$ref": "#/$defs/point"
            }
          },
          "observation_support": {
            "enum": [
              "reviewed_finite",
              "candidate",
              "unknown"
            ]
          },
          "ifc_global_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "approval": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "scan_xyz",
          "observation_state",
          "bim_plane_id"
        ],
        "properties": {
          "sample_id": {
            "type": "string"
          },
          "scan_xyz": {
            "$ref": "#/$defs/point"
          },
          "observation_state": {
            "enum": [
              "observed",
              "occluded",
              "out_of_fov",
              "ambiguous",
              "unknown"
            ]
          },
          "bim_plane_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "source_units": {
      "type": "string",
      "const": "reconstruction_units",
      "description": "Explicit source reconstruction units; omitted only for backwards-compatible v1 fixtures."
    },
    "registration": {
      "type": "object",
      "description": "Optional robust similar-registration setting; never changes field-validation gate.",
      "properties": {
        "method": {
          "enum": [
            "umeyama",
            "ransac_umeyama"
          ]
        },
        "inlier_threshold_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Operator-supplied RANSAC consensus threshold IN METRES"
        },
        "max_trials": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "proposed",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        }
      }
    }
  }
}
